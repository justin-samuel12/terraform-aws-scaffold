#!/bin/bash
set -e

if ! command -v gitleaks >/dev/null 2>&1; then
    echo "gitleaks is not installed; refusing to commit unscanned changes (brew install gitleaks)."
    exit 1
fi
gitleaks git --staged --redact --no-banner --log-level error

if git diff --cached --name-only --diff-filter=ACM | grep -q '\.tf$'; then
    terraform fmt -check -recursive
    if command -v tflint >/dev/null 2>&1; then
        tflint --recursive --format compact
    else
        echo "tflint is not installed; skipping lint (docs/configuration.md)."
    fi
fi

bin/diagram --check
bin/backends --check
