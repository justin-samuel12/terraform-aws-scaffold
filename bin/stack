#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${REPO_ROOT}"

stack="${1:-}"
[[ -n "${stack}" ]] || { echo "usage: bin/stack <region>/<environment>/<component>" >&2; exit 1; }
[[ "${stack}" =~ ^([a-z]{2}-[a-z]+-[0-9]|global)/[a-z][a-z0-9-]*/[a-z][a-z0-9-]*$ ]] || { echo "bin/stack: '${stack}' is not <region>/<environment>/<component> or global/<environment>/<component>" >&2; exit 1; }
dir="live/${stack}"
[[ ! -e "${dir}/context.tf" ]] || { echo "bin/stack: ${dir} already exists" >&2; exit 1; }

depth="$(tr -cd '/' <<<"${stack}" | wc -c | tr -d ' ')"
to_live="$(printf '../%.0s' $(seq 0 "${depth}"))"
to_root="../${to_live}"
component="$(basename "${stack}")"
name="$(tr '-' '_' <<<"${component}")"

mkdir -p "${dir}"
rm -f "$(dirname "${dir}")/.gitkeep" "${dir}/.gitkeep"

"${REPO_ROOT}/bin/backends" "${dir}" >/dev/null

if [[ ! -d "templates/${component}" ]]; then
    echo "created ${dir}, with live/common's files (no template for ${component})"
    exit 0
fi

inputs=""
grep -q '^variable "environment"' "templates/${component}/variables.tf" 2>/dev/null && inputs+="  environment = local.environment"$'\n'
grep -q '^variable "region"' "templates/${component}/variables.tf" 2>/dev/null && inputs+="  region = local.region"$'\n'
grep -q '^variable "config_path"' "templates/${component}/variables.tf" 2>/dev/null && inputs+="  config_path = local.config_dir"$'\n'
providers_block=""
aliases="$(sed -n 's/.*configuration_aliases *= *\[\(.*\)\].*/\1/p' "templates/${component}/versions.tf" 2>/dev/null | tr -d ' ' | tr ',' '\n' | grep . || true)"
if [[ -n "${aliases}" ]]; then
    providers_block=$'\n  providers = {\n    aws = aws\n'
    while read -r a; do providers_block+="    ${a} = ${a}"$'\n'; done <<<"${aliases}"
    providers_block+=$'  }\n'
fi

block=""
[[ -n "${inputs}" ]] && block=$'\n'"${inputs}"

cat > "${dir}/main.tf" <<HCL
module "${name}" {
  source = "${to_root}templates/${component}"
${providers_block}${block}}
HCL
terraform fmt "${dir}/main.tf" >/dev/null

cat > "${dir}/outputs.tf" <<HCL
output "${name}" {
  description = "Everything templates/${component} outputs."
  value       = module.${name}
}
HCL

echo "created ${dir}, calling templates/${component}"
