#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${REPO_ROOT}"
OFF=".github/workflows-off"
ACTIONLINT_IMAGE="${ACTIONLINT_IMAGE:-rhysd/actionlint:1.7.7@sha256:887a259a5a534f3c4f36cb02dca341673c6089431057242cdc931e9f133147e9}"

target_of() {
    case "$1" in
        dependabot.yml) echo .github/dependabot.yml ;;
        CODEOWNERS) echo .github/CODEOWNERS ;;
        *) echo ".github/workflows/$1" ;;
    esac
}

uncomment() { sed -E 's/^# ?//' "$1"; }

check_yaml() {
    local name="$1" file="$2"
    [[ "${name}" == CODEOWNERS ]] && return 0
    yq -e '.' "${file}" >/dev/null || { echo "bin/workflows: ${name} is not valid YAML" >&2; exit 1; }
}

cmd_check() {
    local work f name
    work="$(mktemp -d)"
    trap 'rm -rf "${work}"' RETURN
    for f in "${OFF}"/*; do
        name="$(basename "${f}")"
        if grep -qvE '^(#|$)' "${f}"; then echo "bin/workflows: ${name} has a live line; every line must stay commented" >&2; exit 1; fi
        uncomment "${f}" >"${work}/${name}"
        check_yaml "${name}" "${work}/${name}"
        echo "ok    ${name}"
    done
    mkdir -p "${work}/.github/workflows"
    for f in "${work}"/*.yml; do
        if [[ "$(basename "${f}")" != dependabot.yml ]]; then cp "${f}" "${work}/.github/workflows/"; fi
    done
    printf 'self-hosted-runner:\n  labels:\n    - terraform-check\n    - terraform-trusted\n    - terraform-plan\n    - terraform-apply\n' >"${work}/.github/actionlint.yaml"
    local files
    files="$(cd "${work}" && ls .github/workflows/*.yml)"
    if command -v actionlint >/dev/null; then
        # shellcheck disable=SC2086
        (cd "${work}" && actionlint -config-file .github/actionlint.yaml ${files})
        echo "ok    actionlint $(actionlint -version | head -1)"
    elif command -v docker >/dev/null && docker info >/dev/null 2>&1; then
        # shellcheck disable=SC2086
        docker run --rm --network none -v "${work}:/repo:ro" -w /repo "${ACTIONLINT_IMAGE}" -config-file .github/actionlint.yaml ${files}
        echo "ok    actionlint (${ACTIONLINT_IMAGE%@*})"
    else
        echo "bin/workflows: actionlint is not installed and Docker is not running: the workflows' YAML was checked, their expressions, permissions and shell were not. brew install actionlint, or start Docker." >&2
        exit 1
    fi
}

cmd_on() {
    local f name target
    mkdir -p .github/workflows
    for f in "${OFF}"/*; do
        name="$(basename "${f}")"; target="$(target_of "${name}")"
        uncomment "${f}" >"${target}"
        echo "on    ${target}"
    done
}

cmd_off() {
    local f target
    for f in "${OFF}"/*; do
        target="$(target_of "$(basename "${f}")")"
        rm -f "${target}"
        echo "off   ${target}"
    done
}

case "${1:-}" in
    check) cmd_check ;;
    on) cmd_on ;;
    off) cmd_off ;;
    *) echo "usage: bin/workflows check | on | off" >&2; exit 2 ;;
esac
