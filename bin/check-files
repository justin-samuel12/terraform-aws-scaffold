#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${REPO_ROOT}"
command -v yq >/dev/null || { echo "check-files: yq is required (brew install yq)" >&2; exit 1; }

SOURCE="live"; CONFIG_SOURCE="config"
if [[ "${1:-}" == --examples ]]; then SOURCE="examples"; CONFIG_SOURCE="examples/config"; shift; fi

mkdir -p "${REPO_ROOT}/.check-files"
WORK="$(mktemp -d "${REPO_ROOT}/.check-files/run.XXXXXX")"
trap 'rm -rf "${WORK:?}"' EXIT
mkdir -p "${WORK}/config" "${WORK}/live"
ln -s "${REPO_ROOT}/templates" "${WORK}/templates"
ln -s "${REPO_ROOT}/modules" "${WORK}/modules"
ln -s "${REPO_ROOT}/blueprints" "${WORK}/blueprints"
ln -s "${REPO_ROOT}/scripts" "${WORK}/scripts"
cp -R bin "${WORK}/bin"
cp -R live/common "${WORK}/live/common"
cp "${CONFIG_SOURCE}"/*.yml "${WORK}/config/"
if [[ -d "${CONFIG_SOURCE}/amis" ]]; then cp -R "${CONFIG_SOURCE}/amis" "${WORK}/config/"; fi
for f in "${WORK}"/config/*-*-[0-9].yml; do
    yq -i '(.hub, .vpcs[]) |= (.account_id = (.account_id // "" | select(. != "") // "111111111111") | .team = (.team // "platform"))' "${f}"
done
yq -i '.state.bucket = (.state.bucket // "" | select(. != "") // "example-terraform-state")' "${WORK}/config/global.yml"
yq -i '.pipeline.dedicated_accounts = []' "${WORK}/config/global.yml"
primary=""
for f in "${WORK}"/config/*-*-[0-9].yml; do [[ "$(yq -r '.hub.primary // false' "${f}")" == true ]] && primary="$(basename "${f}" .yml)"; done

stacks=()
if [[ $# -gt 0 ]]; then
    for s in "$@"; do stacks+=("${s#"${SOURCE}"/}"); done
else
    while IFS= read -r d; do
        rel="${d#"${SOURCE}"/}"
        [[ "${rel}" == config* || "${rel}" == common* ]] && continue
        [[ "${SOURCE}" == live && ! -f "${d}/main.tf" ]] && continue
        [[ "$(awk -F/ '{print NF}' <<<"${rel}")" == 3 ]] && stacks+=("${rel}")
    done < <(find "${SOURCE}" -mindepth 3 -maxdepth 3 -type d | sort)
fi

export TF_PLUGIN_CACHE_DIR="${TF_PLUGIN_CACHE_DIR:-${REPO_ROOT}/.terraform.d/plugin-cache}"
mkdir -p "${TF_PLUGIN_CACHE_DIR}"
failed=0
for rel in "${stacks[@]}"; do
    component="${rel##*/}"
    dir="${WORK}/live/${rel}"
    if [[ "${SOURCE}" == live ]]; then
        [[ -f "live/${rel}/main.tf" ]] || { echo "FAIL  ${rel}: not a stack (no main.tf): make stack STACK=${rel}"; failed=1; continue; }
        mkdir -p "${dir}"
        for f in "live/${rel}"/*.tf; do [[ "$(basename "${f}")" == backend.tf ]] || cp -L "${f}" "${dir}/"; done
    elif ! stack_out="$("${WORK}/bin/stack" "${rel}" 2>&1)"; then
        echo "FAIL  ${rel}: make stack"; sed 's/^/      /' <<<"${stack_out}"; failed=1; continue
    fi
    rm -f "${dir}/backend.tf"
    if [[ "${SOURCE}" == live && -f "live/${rel}/.terraform.lock.hcl" ]]; then cp "live/${rel}/.terraform.lock.hcl" "${dir}/"
    else cp tests/lock/.terraform.lock.hcl "${dir}/"; fi
    mkdir -p "${dir}/.check"
    if grep -q '^variable "config_path"' "templates/${component}/variables.tf" 2>/dev/null && ! grep -q config_path "${dir}/main.tf"; then
        perl -0pi -e 's/\n}\s*\z/\n  config_path = local.config_dir\n}\n/' "${dir}/main.tf"
    fi
    rsync -a --exclude '*.tf' --exclude '.terraform' --exclude '.terraform.lock.hcl' --exclude 'tests' --exclude '.gitkeep' "${SOURCE}/${rel}/" "${dir}/"
    region="${rel%%/*}"; [[ "${region}" == global ]] && region="${primary}"
    zones="$(yq -o=json -I=0 '.zones // []' "${WORK}/config/${region}.yml" 2>/dev/null | sed 's/,/, /g')"
    sed -e "s/zone_ids = \[[^]]*\]/zone_ids = ${zones:-[]}/" -e "s/region = \"us-east-1\", name = \"us-east-1\"/region = \"${region}\", name = \"${region}\"/" \
        tests/mock/files.tftest.hcl > "${dir}/.check/files.tftest.hcl"
    init_out=""
    for attempt in 1 2 3; do
        if init_out="$(cd "${dir}" && terraform init -backend=false -input=false -no-color 2>&1)"; then init_out=""; break; fi
        [[ "${attempt}" -lt 3 ]] && sleep 5
    done
    if [[ -n "${init_out}" ]]; then
        echo "FAIL  ${rel}: terraform init"
        grep -E "Error" -A4 <<<"${init_out}" | sed 's/^/      /' | head -12 || true
        failed=1
        continue
    fi
    if ! out="$(cd "${dir}" && terraform validate -no-color 2>&1)"; then
        echo "FAIL  ${rel}: terraform validate"
        grep -E "Error" -A6 <<<"${out}" | sed 's/^/      /' | head -20 || true
        failed=1
        continue
    fi
    if out="$(cd "${dir}" && TF_VAR_config_dir="${WORK}/config" terraform test -no-color -test-directory=.check 2>&1)"; then
        echo "ok    ${rel}"
    else
        echo "FAIL  ${rel}"
        grep -E "Error:" -A8 <<<"${out}" | sed 's/^/      /' | head -40 || true
        failed=1
    fi
done
exit "${failed}"
