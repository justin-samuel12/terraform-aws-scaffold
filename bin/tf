#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 2 ]]; then
    echo "usage: bin/tf <stack directory> <terraform command> [args...]" >&2
    exit 2
fi

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
STACK="$(cd "$1" && pwd)"; shift
COMMAND="$1"
REL="${STACK#"${REPO_ROOT}/"}"

if [[ "${REL}" != live/* || "${REL}" == live/common* ]]; then
    echo "bin/tf: ${STACK} is not a stack under live/." >&2
    exit 2
fi

for a in "$@"; do
    [[ "${a}" == -destroy ]] && { echo "bin/tf: -destroy is not run through this wrapper." >&2; exit 1; }
done
case "${COMMAND} ${2:-}" in
    "destroy "* | "state rm" | "state mv" | "state push" | "state replace-provider" | "force-unlock "*)
        echo "bin/tf: '${COMMAND}${2:+ $2}' is not run through this wrapper." >&2
        exit 1 ;;
esac

command -v yq >/dev/null || { echo "bin/tf: yq is required (brew install yq)." >&2; exit 1; }

CONFIG="${INFRA_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/infra/hashicorp-terraform.config}"
export TF_VAR_config_file="${CONFIG}"
export TF_PLUGIN_CACHE_DIR="${TF_PLUGIN_CACHE_DIR:-${REPO_ROOT}/.terraform.d/plugin-cache}"
mkdir -p "${TF_PLUGIN_CACHE_DIR}"
ENVIRONMENT="$(cut -d/ -f3 <<<"${REL}")"

case "${COMMAND}" in
    fmt | validate | version | providers) exec terraform -chdir="${STACK}" "$@" ;;
    init) [[ " $* " == *" -backend=false "* ]] && exec terraform -chdir="${STACK}" "$@" ;;
esac

refuse() {
    echo "bin/tf: $1" >&2
    echo "bin/tf: the AWS account and the S3 state bucket must exist first and be written in config/ -- docs/configuration.md." >&2
    exit 1
}
LOCATION="$(cut -d/ -f2 <<<"${REL}")"
if [[ "${LOCATION}" == global ]]; then
    REGION=""
    for f in "${REPO_ROOT}"/config/*.yml; do
        [[ "$(yq -r '.hub.primary // false' "${f}")" == true ]] && REGION="$(basename "${f}" .yml)"
    done
    [[ -n "${REGION}" ]] || refuse "no hub in config/ says primary: true, so a global stack has no region."
else
    REGION="${LOCATION}"
fi
REGION_FILE="${REPO_ROOT}/config/${REGION}.yml"
[[ -f "${REGION_FILE}" ]] || refuse "there is no config/${REGION}.yml."
if [[ "${ENVIRONMENT}" == shared ]]; then ENTRY=".hub"; else ENTRY=".vpcs[\"${ENVIRONMENT}\"]"; fi
SETTINGS_FILE="${REGION_FILE}"
if [[ "${LOCATION}" == global && "$(yq -r "${ENTRY} | tag" "${REGION_FILE}")" != "!!map" ]]; then
    for f in "${REPO_ROOT}"/config/*-*-[0-9].yml; do
        [[ "$(yq -r "${ENTRY} | tag" "${f}")" == "!!map" ]] && { SETTINGS_FILE="${f}"; break; }
    done
fi
[[ "$(yq -r "${ENTRY} | tag" "${SETTINGS_FILE}")" == "!!map" ]] || refuse "config/ has no entry for ${ENVIRONMENT}$([[ "${LOCATION}" != global ]] && echo " in ${REGION}.yml")."
ACCOUNT_FILE="${SETTINGS_FILE}"; ACCOUNT_PATH="${ENTRY}.account_id"
if [[ -z "$(yq -r "${ACCOUNT_PATH} // \"\"" "${ACCOUNT_FILE}")" ]]; then ACCOUNT_FILE="${REPO_ROOT}/config/global.yml"; ACCOUNT_PATH=".account_id"; fi
ACCOUNT_ID="$(yq -r "${ACCOUNT_PATH} // \"\"" "${ACCOUNT_FILE}")"
[[ "${ACCOUNT_ID}" =~ ^[0-9]{12}$ && "$(yq -r "${ACCOUNT_PATH} | tag" "${ACCOUNT_FILE}")" == "!!str" ]] \
    || refuse "no quoted 12-digit account_id for ${ENVIRONMENT}: none in config/${REGION}.yml, and none in config/global.yml for every environment (unquoted, YAML drops a leading zero)."
BUCKET="$(yq -r '.state.bucket // ""' "${REPO_ROOT}/config/global.yml")"
BUCKET_REGION="$(yq -r '.state.region // ""' "${REPO_ROOT}/config/global.yml")"
[[ -n "${BUCKET}" && -n "${BUCKET_REGION}" ]] || refuse "config/global.yml has no state.bucket and state.region."
PROFILE=""
[[ -f "${CONFIG}" ]] && PROFILE="$(yq -r ".profiles[\"${ENVIRONMENT}\"] // \"\"" "${CONFIG}")"

if [[ "${COMMAND}" == init ]]; then
    KEY="$(sed -n 's/^ *key *= *"\(.*\)"/\1/p' "${STACK}/backend.tf" 2>/dev/null)"
    if ! err="$(aws s3api list-objects-v2 --bucket "${BUCKET}" --region "${BUCKET_REGION}" --prefix "${KEY}" --max-keys 1 ${PROFILE:+--profile "${PROFILE}"} 2>&1 >/dev/null)"; then
        case "${err}" in
            *NoSuchBucket*) refuse "the state bucket ${BUCKET} (${BUCKET_REGION}) does not exist." ;;
            *AccessDenied* | *Forbidden*) refuse "${PROFILE:-the active credentials} may not read ${KEY} in ${BUCKET}: the bucket policy lets each account reach only its own environments' keys (make bootstrap writes it)." ;;
            *) refuse "the state bucket ${BUCKET} could not be reached${PROFILE:+ with profile ${PROFILE}} (expired login? aws sso login): ${err##*: }" ;;
        esac
    fi
fi

"${REPO_ROOT}/bin/backends" --check "${REL}" || refuse "${REL}/backend.tf does not match config/global.yml."

[[ -n "${PROFILE}" ]] && export AWS_PROFILE="${PROFILE}"

[[ "${COMMAND}" == plan || "${COMMAND}" == apply ]] || exec terraform -chdir="${STACK}" "$@"

cd "${REPO_ROOT}"
source bin/lib/units.sh
NAME="${REL#live/}"
PLAN="${STACK}/.terraform/plan.tfplan"
PLAN_FP="${STACK}/.terraform/plan.fingerprint"
MAX_AGE="${PLAN_MAX_AGE_MINUTES:-240}"
FP="$(fingerprint "files:${NAME}")"
note() { echo "bin/tf: $*" >&2; }
stop() { echo "bin/tf: $*" >&2; exit 1; }
shift

if [[ "${COMMAND}" == plan ]]; then
    while read -r kind s why; do
        case "${kind}" in
            missing) note "${s} does not exist yet, and this stack looks things up in it (make stack STACK=${s})" ;;
            not-applied) note "not applied yet: ${s} (make order STACK=${NAME})" ;;
            unknown) note "could not check whether ${s} is applied: ${why}" ;;
        esac
    done <<<"$(bin/order --unapplied "${NAME}" 2>/dev/null || true)"

    if ! passed_before "preflight:${NAME}" "${FP}"; then
        dirs="$(module_closure "${REL}")"
        for d in ${dirs}; do terraform fmt -check -list=true "${d}" >/dev/null || stop "${d} is not formatted: make fmt"; done
        terraform -chdir="${STACK}" validate -no-color >/dev/null || { terraform -chdir="${STACK}" validate -no-color >&2 || true; stop "the stack is not valid."; }
        if command -v tflint >/dev/null; then
            tflint --init --config="${REPO_ROOT}/.tflint.hcl" >/dev/null 2>&1 \
                || stop "tflint could not install its plugins (it needs the internet once): run make lint to see why."
            for d in ${dirs}; do
                [[ "${d}" == live/* ]] && continue
                rc=0; out="$(tflint --chdir="${d}" --config="${REPO_ROOT}/.tflint.hcl" --format compact 2>&1)" || rc=$?
                case "${rc}" in
                    0) ;;
                    2) echo "${out}" >&2; stop "${d} has the lint findings above (make lint)." ;;
                    *) echo "${out}" >&2; stop "tflint could not run in ${d} (above); this is not a finding in the code." ;;
                esac
            done
        fi
        record_pass "preflight:${NAME}" "${FP}"
    fi

    for a in "$@"; do [[ "${a}" == -out=* ]] && stop "make plan saves the plan itself; leave out ${a}."; done
    rm -f "${PLAN}" "${PLAN_FP}"
    terraform -chdir="${STACK}" plan "$@" -out="${PLAN}"
    echo "${FP} $(date +%s)" > "${PLAN_FP}"
    note "plan saved: make apply STACK=${NAME} applies exactly this one, within ${MAX_AGE} minutes and while nothing it read changes."
    exit 0
fi

for a in "$@"; do
    [[ "${a}" == -input=false ]] || stop "options belong to the plan (make plan STACK=${NAME} ARGS='${a}'), which apply then runs as it is."
done
[[ -f "${PLAN}" && -f "${PLAN_FP}" ]] || stop "there is no saved plan for ${NAME}: make plan STACK=${NAME} first, and review it."
read -r saved_fp saved_at < "${PLAN_FP}"
[[ "${saved_fp}" == "${FP}" ]] || stop "the stack, its template, its modules or config/ changed since the plan: make plan STACK=${NAME} again."
age=$(( ($(date +%s) - saved_at) / 60 ))
[[ "${age}" -le "${MAX_AGE}" ]] || stop "the plan is ${age} minutes old (PLAN_MAX_AGE_MINUTES is ${MAX_AGE}): make plan STACK=${NAME} again, so it reflects AWS now."
needs="$(bin/order --unapplied "${NAME}" 2>/dev/null || true)"
blocking="$(awk '$1 == "missing" || $1 == "not-applied" {print $2}' <<<"${needs}" | xargs)"
[[ -z "${blocking}" ]] || stop "apply these first, which this stack looks things up in: ${blocking}."
while read -r kind s why; do [[ "${kind}" == unknown ]] && note "could not check whether ${s} is applied: ${why}"; done <<<"${needs}"

terraform -chdir="${STACK}" show -no-color "${PLAN}" | grep -E '^(Plan:|No changes|Changes to Outputs)' >&2 || true
if [[ -t 0 ]]; then
    read -r -p "Apply the plan made $(( age )) minutes ago to ${NAME}? Only 'yes' applies: " answer
    [[ "${answer}" == yes ]] || stop "not applied."
else
    [[ "${APPLY_CONFIRMED:-}" == yes ]] || stop "no terminal to confirm in: a pipeline whose approval step has passed sets APPLY_CONFIRMED=yes."
fi

status=0
terraform -chdir="${STACK}" apply -input=false "${PLAN}" || status=$?
rm -f "${PLAN}" "${PLAN_FP}"
[[ "${status}" == 0 ]] || exit "${status}"
dependents="$(bin/order --dependents "${NAME}" 2>/dev/null || true)"
[[ -z "${dependents}" ]] || note "these look ${NAME} up; plan them again: $(xargs <<<"${dependents}")"
