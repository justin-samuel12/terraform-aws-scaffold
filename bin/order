#!/usr/bin/env bash
set -euo pipefail
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/common.sh"
cd "${REPO_ROOT}"

CHECK=0; OFFLINE=0; TARGET=""; QUERY=""
for a in "$@"; do
    case "${a}" in
        --check) CHECK=1 ;;
        --unapplied | --dependents) QUERY="${a#--}" ;;
        --offline) OFFLINE=1 ;;
        -*) echo "bin/order: unknown option ${a}" >&2; exit 2 ;;
        *) TARGET="${a#live/}"; TARGET="${TARGET%/}" ;;
    esac
done

if [[ "${CHECK}" == 1 && "$(yq -r '.order_check // true' "${CONFIG_DIR}/global.yml")" == false ]]; then
    echo "order check: off (order_check: false in config/global.yml)"
    exit 0
fi

PRIMARY="$(primary_region)"
REGIONS="$(region_files | xargs)"
NEEDS="templates/needs.yml"
NEED_KEYS="needs when_present when_primary named_in_files"

builders_of() {
    case "$1" in
        kms_key) echo keys ;;
        sqs_queue | sns_topic) echo messaging ;;
        security_group) echo security-groups ;;
        vpc | subnet | subnets) echo "network hub" ;;
        route_tables | vpc_peering_connection) echo network ;;
        ec2_transit_gateway | ec2_transit_gateway_route_table | ram_resource_share | route53_resolver_rule | ec2_managed_prefix_list) echo hub ;;
        route53_zone) echo dns ;;
        acm_certificate) echo certificates ;;
        s3_bucket) echo "logging buckets" ;;
        lb | lb_listener | lb_target_group) echo load-balancers ;;
        iam_instance_profile | iam_policy) echo iam ;;
        instance) echo compute ;;
    esac
}

stacks="$(find live -mindepth 4 -maxdepth 4 -name main.tf -not -path 'live/common/*' | sed 's#^live/##; s#/main.tf$##' | sort)"
exists() { grep -qx "$1" <<<"${stacks}"; }

own_accounts="$(for env in $(environments); do [[ "${env}" != shared && "$(account_for "${env}")" != "$(account_for shared)" ]] && echo "${env}" || true; done | jq -R . | jq -sc .)"
peerings="$(for f in live/*/*/network/config/peering/*.yml; do
    [[ -f "${f}" ]] || continue
    stack="${f#live/}"; stack="${stack%/config/peering/*}"
    peer="$(yq -r '.peer_vpc_id // ""' "${f}")"; peer_region="$(yq -r '.peer_region // ""' "${f}")"
    [[ "${peer}" == vpc-* || -z "${peer}" ]] && continue
    printf '{"%s":["%s/%s/network"]}\n' "${stack}" "${peer_region:-${stack%%/*}}" "${peer}"
done | jq -sc 'reduce .[] as $e ({}; . as $acc | reduce ($e | keys[]) as $k ($acc; .[$k] += $e[$k]))')"
vpc_regions="$(for r in ${REGIONS}; do yq -o=json -I0 ".vpcs // {} | keys | map({(.): [\"${r}\"]}) | .[]" "${CONFIG_DIR}/${r}.yml"; done | jq -sc 'reduce .[] as $e ({}; . as $acc | reduce ($e | keys[]) as $k ($acc; .[$k] += $e[$k]))')"
graph="$(yq -o=json '.' "${NEEDS}" | jq -c --arg stacks "${stacks}" --arg regions "${REGIONS}" --arg primary "${PRIMARY}" --argjson own "${own_accounts}" --argjson vpc_regions "${vpc_regions:-{\}}" '
  . as $needs
  | ($stacks | split("\n") | map(select(. != ""))) as $all
  | ($regions | split(" ") | map(select(. != ""))) as $regions
  | def expand($e; $region; $env):
      ($e | gsub("\\{environment\\}"; $env) | gsub("\\{region\\}"; $region)) as $x
      | if ($x | contains("{other_regions}")) then $regions[] | select(. != $region) as $r | $x | gsub("\\{other_regions\\}"; $r)
        elif ($x | contains("{each_region}")) then ($x | split("/")[1]) as $e | $regions[] as $r | select($e == "shared" or (($vpc_regions[$e] // []) | index($r)) != null) | $x | gsub("\\{each_region\\}"; $r)
        else $x end;
    def resolve($p):
      ($p | split("/")) as $parts
      | if ($all | index($p)) then $p
        elif $parts[1] != "shared" and ($own | index($parts[1]) | not) and ($all | index("\($parts[0])/shared/\($parts[2])")) then "\($parts[0])/shared/\($parts[2])"
        else "?" + $p end;
  [ $all[] as $s
    | ($s | split("/")) as [$loc, $env, $comp]
    | (if $loc == "global" then $primary else $loc end) as $region
    | ($needs[$comp] // {}) as $n
    | ([($n.needs // [])[], (if $loc == $primary then ($n.when_primary // [])[] else empty end)] | map(expand(.; $region; $env)) | map(resolve(.))) as $required
    | ([($n.when_present // [])[] | expand(.; $region; $env) | resolve(.)] | map(select(startswith("?") | not))) as $optional
    | {($s): {
        needs: ([$required[], $optional[]] | map(select(startswith("?") | not and . != $s)) | unique),
        missing: ($required | map(select(startswith("?")) | ltrimstr("?")) | unique)
      }}
  ] | add // {}' | jq -c --argjson extra "${peerings:-{\}}" 'keys as $all | with_entries(($extra[.key] // []) as $e | .value.needs = ((.value.needs + [$e[] | select(IN($all[]))]) | unique) | .value.missing = ((.value.missing + [$e[] | select(IN($all[]) | not)]) | unique))')"

WAVES='
def closure_in($g; $start; $within):
  {set: $start}
  | until((([.set[] | $g[.].needs[]? | select(IN($within[]))] + .set) | unique) == .set; .set = (([.set[] | $g[.].needs[]? | select(IN($within[]))] + .set) | unique))
  | .set;
def waves($g; $nodes):
  {left: $nodes, done: [], out: []}
  | until(.left == [] or .loop != null;
      . as $s
      | ([$s.left[] | select(([$g[.].needs[] | select(IN($nodes[]))] - $s.done) == [])]) as $ready
      | if $ready == [] then .loop = $s.left
        else .out += [$ready] | .done += $ready | .left -= $ready end)
  | if .loop then .loop as $left | .loop = [$left[] | select(. as $n | closure_in($g; [$g[$n].needs[] | select(IN($left[]))]; $left) | index($n))] else . end;
def closure($g; $start):
  {set: $start}
  | until((([.set[] | $g[.].needs[]?] + .set) | unique) == .set; .set = (([.set[] | $g[.].needs[]?] + .set) | unique))
  | .set;
'

if [[ "${CHECK}" == 1 ]]; then
    problems=""
    for t in $(yq -r 'keys | .[]' "${NEEDS}"); do
        [[ -d "templates/${t}" ]] || { problems+="${NEEDS}: ${t} is not a template"$'\n'; continue; }
        bad_keys="$(T="${t}" yq -r '.[strenv(T)] // {} | keys | .[]' "${NEEDS}" | while read -r k; do [[ " ${NEED_KEYS} " == *" ${k} "* ]] || echo "${k}"; done | xargs)"
        [[ -z "${bad_keys}" ]] || problems+="${NEEDS}: ${t} has unknown key ${bad_keys} (keys are ${NEED_KEYS// /, })"$'\n'
        declared=" ${t} $(T="${t}" yq -r '.[strenv(T)] // {} | [.needs // [], .when_present // [], .when_primary // [], .named_in_files // []] | flatten | .[]' "${NEEDS}" | sed 's#.*/##' | xargs) "
        for d in $(grep -ho 'data "aws_[a-z0-9_]*"' "templates/${t}"/*.tf 2>/dev/null | sed 's/data "aws_//; s/"//' | sort -u); do
            b="$(builders_of "${d}")"; [[ -n "${b}" ]] || continue
            hit=0; for c in ${b}; do [[ "${declared}" == *" ${c} "* ]] && hit=1; done
            [[ "${hit}" == 1 ]] || problems+="templates/${t} looks up aws_${d} (built by ${b// / or }), but its entry in ${NEEDS} does not list it"$'\n'
        done
    done
    for t in templates/*/; do t="$(basename "${t}")"; T="${t}" yq -e 'has(strenv(T))' "${NEEDS}" >/dev/null 2>&1 || problems+="${NEEDS} has no entry for ${t}: every template says what it needs, if only needs: []"$'\n'; done
    loop="$(jq -r "${WAVES}"' . as $g | waves($g; keys) | .loop // [] | .[]' <<<"${graph}")"
    [[ -z "${loop}" ]] || problems+="these stacks need each other in a loop, so none of them can be applied first: $(xargs <<<"${loop}")"$'\n'
    if [[ -n "${problems}" ]]; then printf '%s' "${problems}" | sed 's/^/order check: /' >&2; exit 1; fi
    echo "order check: every lookup is declared in ${NEEDS}; $(jq 'length' <<<"${graph}") stacks, no loops"
    exit 0
fi

bucket="$(yq -r '.state.bucket // ""' "${CONFIG_DIR}/global.yml")"; bucket_region="$(yq -r '.state.region // ""' "${CONFIG_DIR}/global.yml")"
state_of() { # state_of <stack> -> applied | not-applied | unknown <why> | (nothing, when there is nothing to check)
    [[ "${OFFLINE}" == 1 || -z "${bucket}" ]] && return 0
    local key env p err
    key="$(sed -n 's/^ *key *= *"\(.*\)"/\1/p' "live/$1/backend.tf" 2>/dev/null)"
    [[ -n "${key}" ]] || return 0
    env="$(cut -d/ -f2 <<<"$1")"; p="$(profile_for "${env}")"; [[ -n "${p}" ]] || p="$(profile_for shared)"
    local out
    if out="$(aws s3api list-objects-v2 --bucket "${bucket}" --prefix "${key}" --max-keys 2 --query "length(Contents[?Key=='${key}'] || \`[]\`)" --output text --region "${bucket_region}" ${p:+--profile "${p}"} 2>&1)"; then
        [[ "${out}" =~ ^[1-9] ]] && echo applied || echo not-applied
    elif err="${out}"; [[ "${err}" == *AccessDenied* || "${err}" == *Forbidden* ]]; then echo "unknown ${p:-the active credentials} may not read its state"
    else echo "unknown ${p:-the active credentials} could not reach the bucket (expired login? aws sso login --profile ${p:-<name>})"; fi
}
status_of() {
    local st; st="$(state_of "$1")"
    case "${st}" in
        applied) printf '%s✓ applied%s' "${C_OK}" "${C_END}" ;;
        not-applied) printf '%s· not yet%s' "${C_DIM}" "${C_END}" ;;
        unknown*) printf '%s? cannot check: %s%s' "${C_WARN}" "${st#unknown }" "${C_END}" ;;
    esac
}

print_waves() { # print_waves <json array of waves>
    local n=0 wave s first
    while read -r wave; do
        n=$((n + 1)); first=1
        for s in $(jq -r '.[]' <<<"${wave}"); do
            if [[ "${first}" == 1 ]]; then printf '  Wave %-3s ' "${n}"; first=0; else printf '           '; fi
            printf '%-44s %s\n' "${s}" "$(status_of "${s}")"
        done
    done <<<"$(jq -c '.[]' <<<"$1")"
}

missing_for() { # missing_for <json array of stacks> -> lines "stack needs missing"
    jq -r --argjson set "$1" '. as $g | $set[] | . as $s | $g[$s].missing[] | "\($s) needs \(.), which does not exist yet: make stack STACK=\(.)"' <<<"${graph}"
}

if [[ -z "${TARGET}" || "$(tr -cd / <<<"${TARGET}" | wc -c | tr -d ' ')" == 1 ]]; then
    if [[ -z "${TARGET}" ]]; then start="$(jq -c 'keys' <<<"${graph}")"; title="every stack"
    else
        start="$(jq -c --arg p "${TARGET}/" '[keys[] | select(startswith($p))]' <<<"${graph}")"
        [[ "${start}" != "[]" ]] || { echo "bin/order: no stacks under live/${TARGET}" >&2; exit 1; }
        title="${TARGET}, with everything it needs"
    fi
    result="$(jq -c --argjson start "${start}" "${WAVES}"' . as $g | waves($g; closure($g; $start))' <<<"${graph}")"
    head1 "Order for ${title}"
    print_waves "$(jq -c '.out' <<<"${result}")"
    loop="$(jq -r '.loop // [] | join(" ")' <<<"${result}")"
    [[ -z "${loop}" ]] || bad "these need each other in a loop, so none can go first: ${loop}"
    missing="$(missing_for "$(jq -c '.done' <<<"${result}")")"
    if [[ -n "${missing}" ]]; then echo; while read -r m; do warn "${m}"; done <<<"${missing}"; fi
    echo
    [[ "${OFFLINE}" == 1 || -z "${bucket}" ]] && say "Stacks in one wave do not depend on each other.$([[ -z "${bucket}" ]] && echo " No state bucket yet, so nothing is applied.")" \
        || say "Stacks in one wave do not depend on each other. Next: whatever is not yet applied in the first wave that has any."
    echo
    exit 0
fi

exists "${TARGET}" || { echo "bin/order: no stack at live/${TARGET}" >&2; exit 1; }

if [[ "${QUERY}" == unapplied ]]; then
    jq -r --arg t "${TARGET}" '.[$t].missing[] | "missing \(.)"' <<<"${graph}"
    [[ "${OFFLINE}" == 1 || -z "${bucket}" ]] && exit 0
    for s in $(jq -r --arg t "${TARGET}" '.[$t].needs[]' <<<"${graph}"); do
        ( st="$(state_of "${s}")"; case "${st}" in not-applied) echo "not-applied ${s}" ;; unknown*) echo "unknown ${s} ${st#unknown }" ;; esac ) &
    done
    wait
    exit 0
fi
result="$(jq -c --arg t "${TARGET}" "${WAVES}"' . as $g | waves($g; closure($g; [$t]) - [$t])' <<<"${graph}")"
after="$(jq -r --arg t "${TARGET}" '. as $g | {set: [$t]} | until(([.set[] as $s | $g | to_entries[] | select(.value.needs | index($s)) | .key] + .set | unique) == .set; .set = ([.set[] as $s | $g | to_entries[] | select(.value.needs | index($s)) | .key] + .set | unique)) | .set - [$t] | .[]' <<<"${graph}")"
if [[ "${QUERY}" == dependents ]]; then [[ -n "${after}" ]] && echo "${after}"; exit 0; fi
head1 "${TARGET}"
if [[ "$(jq '.out | length' <<<"${result}")" == 0 ]]; then say "Needs nothing applied first."
else say "Needs, applied first:"; print_waves "$(jq -c '.out' <<<"${result}")"; fi
missing="$(missing_for "$(jq -c --arg t "${TARGET}" '.done + [$t]' <<<"${result}")")"
if [[ -n "${missing}" ]]; then while read -r m; do warn "${m}"; done <<<"${missing}"; fi
echo
if [[ -z "${after}" ]]; then say "Nothing looks it up."
else say "Looks it up, so plan again after applying it:"; while read -r s; do say "  ${s}"; done <<<"${after}"; fi
echo
