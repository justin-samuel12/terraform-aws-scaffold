#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${REPO_ROOT}"

command -v yq >/dev/null || { echo "bin/backends: yq is required (brew install yq)." >&2; exit 1; }

check=0
if [[ "${1:-}" == "--check" ]]; then check=1; shift; fi

bucket="$(yq -r '.state.bucket // ""' config/global.yml)"
region="$(yq -r '.state.region // ""' config/global.yml)"
key_format="$(yq -r '.state.key // "{region}/{environment}/{component}"' config/global.yml)"
for part in "{environment}" "{component}"; do
    [[ "${key_format}" == *"${part}"* ]] || { echo "bin/backends: state.key in config/global.yml must contain ${part}, or two stacks could share a state." >&2; exit 1; }
done

primary=""
for f in config/*-*-[0-9].yml; do
    [[ "$(yq -r '.hub.primary // false' "${f}")" == true ]] && primary="$(basename "${f}" .yml)"
done

key_for() {
    local location environment component file entry account
    location="$(cut -d/ -f2 <<<"$1")"
    environment="$(cut -d/ -f3 <<<"$1")"
    component="$(cut -d/ -f4 <<<"$1")"
    file="config/$([[ "${location}" == global ]] && echo "${primary}" || echo "${location}").yml"
    if [[ "${environment}" == shared ]]; then entry=".hub"; else entry=".vpcs[\"${environment}\"]"; fi
    account="$(yq -r "${entry}.account_id // \"\"" "${file}" 2>/dev/null)"
    [[ -n "${account}" ]] || account="$(yq -r '.account_id // ""' config/global.yml 2>/dev/null)"
    local key="${key_format//\{region\}/${location}}"
    key="${key//\{environment\}/${environment}}"
    key="${key//\{component\}/${component}}"
    key="${key//\{account_id\}/${account:-unknown-account}}"
    echo "${key}/terraform.tfstate"
}

render() {
    cat <<HCL
terraform {
  backend "s3" {
    bucket       = "${bucket}"
    region       = "${region}"
    key          = "$(key_for "$1")"
    use_lockfile = true
    encrypt      = true
  }
}
HCL
}

if [[ $# -gt 0 ]]; then
    stacks="$*"
else
    stacks="$(find live -mindepth 4 -maxdepth 4 -name context.tf -not -path 'live/common/*' -exec dirname {} \; | sort)"
fi

all_stacks="$(find live -mindepth 4 -maxdepth 4 -name context.tf -not -path 'live/common/*' -exec dirname {} \; | sort)"
duplicates="$(for stack in ${all_stacks}; do key_for "${stack}"; done | sort | uniq -d)"
[[ -z "${duplicates}" ]] || { echo "bin/backends: state.key gives two stacks the same state: ${duplicates}" >&2; exit 1; }

stale=0
for stack in ${stacks}; do
    if [[ "${check}" == 1 ]]; then
        if ! diff -q <(render "${stack}") "${stack}/backend.tf" >/dev/null 2>&1; then
            echo "${stack}/backend.tf is missing or does not match config/global.yml: run make backends and stage it." >&2
            stale=1
        fi
    else
        render "${stack}" > "${stack}/backend.tf"
        echo "wrote ${stack}/backend.tf"
    fi
done
exit "${stale}"
