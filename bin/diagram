#!/usr/bin/env bash
# Generate docs/diagram.md from the IP plan and the live/ tree; --check fails if it is stale -- docs/diagram.md.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
OUT="${REPO_ROOT}/docs/diagram.md"
cd "${REPO_ROOT}"

command -v jq >/dev/null || { echo "bin/diagram: jq is required." >&2; exit 1; }

# The IP plan is pure Terraform with no provider: evaluate it, no AWS involved.
export TF_PLUGIN_CACHE_DIR="${TF_PLUGIN_CACHE_DIR:-${REPO_ROOT}/.terraform.d/plugin-cache}"
terraform -chdir=modules/ip-plan init -backend=false -input=false >/dev/null
networks="$(echo 'jsonencode(local.networks)' | terraform -chdir=modules/ip-plan console | jq -r 'fromjson')"

# Built = the stack has .tf files of its own, not only the links to live/common.
status() { [[ -n "$(find "live/$1" -maxdepth 1 -name '*.tf' -type f 2>/dev/null)" ]] && echo built || echo planned; }
id() { echo "$1" | tr '/-' '__'; }
region_name() { case "$1" in us-east-1) echo "N. Virginia";; us-east-2) echo "Ohio";; us-west-1) echo "N. California";; us-west-2) echo "Oregon";; *) echo "$1";; esac; }

regions="$(jq -r 'keys[] | split("/")[1]' <<<"${networks}" | sort -u)"

render() {
    echo "# Infrastructure diagram"
    echo
    echo "Generated by \`make diagram\` from \`modules/ip-plan\` and the \`live/\` tree. Do not edit by hand."
    echo "Solid boxes have a stack in \`live/\`; dashed boxes are in the IP plan with no stack yet."
    echo
    echo '```mermaid'
    echo 'flowchart TB'
    echo '  hq["HQ<br/>on-premises"]'
    for region in ${regions}; do
        echo "  subgraph $(id "${region}")[\"$(region_name "${region}") · ${region}\"]"
        echo "    direction TB"
        hub_cidr="$(jq -r --arg k "shared/${region}" '.[$k].cidr // empty' <<<"${networks}")"
        echo "    hub_$(id "${region}")[\"Hub<br/>Transit Gateway · egress ${hub_cidr}\"]:::$(status "${region}/shared/hub")"
        for key in $(jq -r --arg r "${region}" 'to_entries[] | select(.value.purpose == "spoke" and (.key | endswith("/" + $r))) | .key' <<<"${networks}"); do
            env="${key%%/*}"
            cidr="$(jq -r --arg k "${key}" '.[$k].cidr' <<<"${networks}")"
            echo "    $(id "${key}")[\"${env}<br/>${cidr}\"]:::$(status "${region}/${env}/network")"
        done
        echo "  end"
    done
    for region in ${regions}; do
        echo "  hq ---|VPN| hub_$(id "${region}")"
        for key in $(jq -r --arg r "${region}" 'to_entries[] | select(.value.purpose == "spoke" and (.key | endswith("/" + $r))) | .key' <<<"${networks}"); do
            echo "  hub_$(id "${region}") --- $(id "${key}")"
        done
    done
    set -- ${regions}
    if [[ $# -eq 2 ]]; then
        echo "  hub_$(id "$1") <-->|peering| hub_$(id "$2")"
    fi
    echo '  classDef built fill:#e8f1fb,stroke:#2f6fb3,stroke-width:2px'
    echo '  classDef planned fill:#ffffff,stroke:#999999,stroke-dasharray:5 4'
    echo '```'
    echo
    echo "## Stacks"
    echo
    echo "| Stack | Template | Modules |"
    echo "|---|---|---|"
    stacks="$(find live -mindepth 2 -maxdepth 4 -name '*.tf' -not -path 'live/common/*' -not -path '*/.terraform/*' -exec dirname {} \; | sort -u)"
    if [[ -z "${stacks}" ]]; then
        echo "| (none yet) | | |"
    else
        for stack in ${stacks}; do
            # A stack calls a template, which calls the modules; list both.
            template="$( (grep -hoE 'source\s*=\s*"[^"]*templates/[a-z-]+' "${stack}"/*.tf 2>/dev/null || true) | sed -E 's#.*templates/##' | head -n1)"
            files=("${stack}"/*.tf)
            [[ -n "${template}" ]] && files+=(templates/"${template}"/*.tf)
            modules="$( (grep -hoE 'source\s*=\s*"[^"]*modules/[a-z-]+' "${files[@]}" 2>/dev/null || true) | sed -E 's#.*modules/##' | sort -u | paste -sd, - | sed 's/,/, /g')"
            echo "| \`${stack#live/}\` | ${template:+\`templates/${template}\`} | ${modules:-} |"
        done
    fi
    echo
    echo "## Subnets"
    echo
    echo "Every VPC's subnets, from \`config/\`, in address order. A stack refers to a subnet by its \`Subnet\` tag."
    # One table per VPC: region, then the hub, then environments; rows sorted by address.
    jq -r '
        to_entries
        | sort_by(.key | split("/") | [.[1], (if .[0] == "shared" then 0 else 1 end), .[0]])
        | .[]
        | .key as $key | .value as $n
        | "\n### \($key | split("/") | .[1]) / \($key | split("/") | .[0]) (`\($n.cidr)`)\n\n| Subnet tag | Zone | CIDR |\n|---|---|---|",
          ([ range(0; $n.zones | length) as $i
             | $n.subnets | to_entries[]
             | { tag: (.key + "-" + ($n.zones[$i] | split("-") | .[1])), zone: $n.zones[$i], cidr: .value[$i] } ]
           | sort_by(.cidr | split("/") | .[0] | split(".") | map(tonumber))
           | .[] | "| `\(.tag)` | \(.zone) | \(.cidr) |")
    ' <<<"${networks}"
}

if [[ "${1:-}" == "--check" ]]; then
    if ! diff -q <(render) "${OUT}" >/dev/null 2>&1; then
        echo "docs/diagram.md is out of date: run make diagram and stage it." >&2
        exit 1
    fi
    exit 0
fi

render > "${OUT}"
echo "wrote docs/diagram.md"
