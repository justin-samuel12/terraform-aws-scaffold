#!/usr/bin/env bash
set -euo pipefail
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/common.sh"
cd "${REPO_ROOT}"

APP="${1:-}"
files="$(find live examples -mindepth 4 -name '*.yml' -path '*/*/*/*/*' \
        -not -path '*/deployments/*' -not -path '*/tests/*' -not -path '*/engine-versions/*' -not -path '*/.terraform/*' 2>/dev/null | sort |
    while read -r f; do
        stack="$(cut -d/ -f1-4 <<<"${f}")"
        case "${stack##*/}" in compute | containers | databases) ;; *) continue ;; esac
        b="$(yq -r '.blueprint // ""' "${f}" 2>/dev/null)"; [[ -n "${b}" ]] || continue
        echo "${stack} $(basename "${f}" .yml) ${stack##*/}/${b} ${f}"
    done)"

if [[ -z "${APP}" ]]; then
    head1 "Apps on blueprints"
    [[ -n "${files}" ]] || { say "None yet: a compute, containers or databases file with blueprint: <name>/v<n> puts an app on one."; echo; exit 0; }
    printf '  %-26s %-34s %s\n' APP BLUEPRINT WHERE
    awk '{print $2, $3, $1}' <<<"${files}" | sort | awk '{w[$1" "$2] = w[$1" "$2] (w[$1" "$2] ? ", " : "") $3} END {for (k in w) {split(k, a, " "); printf "  %-26s %-34s %s\n", a[1], a[2], w[k]}}' | sort
    echo
    say "Blueprints in use: $(awk '{print $3}' <<<"${files}" | sort -u | xargs)"
    say "make render APP=<app> shows one app across its environments."
    echo
    exit 0
fi

mine="$(awk -v app="${APP}" '$2 == app' <<<"${files}")"
[[ -n "${mine}" ]] || { echo "bin/render: no compute, containers or databases file for ${APP} names a blueprint" >&2; exit 1; }
wheres="$(awk '{print $1}' <<<"${mine}")"

head1 "${APP}"
file_of() { awk -v w="$1" -v app="${APP}" '$1 == w && $2 == app {print $4; exit}' <<<"${files}"; }
json_of() { yq -o=json '.' "$(file_of "$1")"; }
keys="$(for w in ${wheres}; do json_of "${w}" | jq -r 'paths(scalars) | map(tostring) | join(".")'; done | grep -v '^blueprint$' | sort -u)"
printf '  %-36s' ""; for w in ${wheres}; do printf ' %-26s' "${w#live/}"; done; echo
printf '  %-36s' "blueprint"; for w in ${wheres}; do printf ' %-26s' "$(yq -r '.blueprint' "$(file_of "${w}")")"; done; echo
while read -r k; do
    [[ -n "${k}" ]] || continue
    printf '  %-36s' "${k}"
    for w in ${wheres}; do
        v="$(json_of "${w}" | jq -r --arg k "${k}" 'getpath($k | split(".") | map(if test("^[0-9]+$") then tonumber else . end)) // "" | tostring')"
        printf ' %-26s' "${v:-·}"
    done
    echo
done <<<"${keys}"
echo
if [[ "$(awk '{print $3}' <<<"${mine}" | sort -u | wc -l | tr -d ' ')" -gt 1 ]]; then
    warn "${APP} is on more than one blueprint version: deliberate while a new version rolls out, a leftover otherwise."
fi
say "· = the blueprint's own value. Everything not listed comes from the blueprint (blueprints/<stack>/<name>/<version>.yml)."
echo
