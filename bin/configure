#!/usr/bin/env bash
set -euo pipefail
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/common.sh"
cd "${REPO_ROOT}"

ask_valid() {
    local answer tries=0
    while [[ "${tries}" -lt 5 ]]; do
        answer="$(ask "$1" "$2")"
        [[ -z "$3" || "${answer}" =~ $3 ]] && { echo "${answer}"; return 0; }
        warn "$4" >&2
        tries=$((tries + 1))
    done
    warn "giving up after five answers that were not $4" >&2
    return 1
}
var() { local name; name="$(tr -c 'a-zA-Z0-9\n' '_' <<<"$1")"; echo "V_${name}"; }
put() { printf -v "$(var "$1")" '%s' "$2"; }
get() { local v; v="$(var "$1")"; echo "${!v:-}"; }
cur() { [[ -n "$1" && -f "${CONFIG_DIR}/$1.yml" ]] && yq -r "$2 // \"\"" "${CONFIG_DIR}/$1.yml" || echo ""; }

RE_CIDR16='^10\.[0-9]{1,3}\.0\.0/16$'
RE_CIDR20='^10\.[0-9]{1,3}\.(0|16|32|48|64|80|96|112|128|144|160|176|192|208|224|240)\.0/20$'
RE_ENV='^[a-z][a-z0-9-]{0,19}$'
RESERVED_ENVS=" shared global common "
ENV_COMPONENTS="network security-groups endpoints keys backups certificates load-balancers waf databases storage buckets messaging access patching compute containers kubernetes records lambda"
SHARED_COMPONENTS="hub logging session-manager documents"
EXAMPLES="examples/us-east-1/development"

used_octets=" "
take_cidr() { used_octets+="$(cut -d. -f2 <<<"$1") "; }
next_cidr() { local o="$1"; while [[ "${used_octets}" == *" ${o} "* ]]; do o=$((o + 1)); done; echo "10.${o}.0.0/16"; }

zones_for() {
    local found=""
    [[ -n "${first_profile:-}" ]] && found="$(aws ec2 describe-availability-zones --region "$1" --profile "${first_profile}" --filters Name=zone-type,Values=availability-zone \
        --query 'AvailabilityZones[].ZoneId' --output text 2>/dev/null | tr '\t' '\n' | sort | head -n 3 | paste -sd, - || true)"
    [[ -n "${found}" ]] && say "$1's zone IDs, from AWS: ${found}" >&2
    ask_valid "Zone IDs, comma-separated (2 to 6)" "${found:-$2}" '^[a-z0-9]+-az[1-6](,[a-z0-9]+-az[1-6]){1,5}$' "zone IDs look like use2-az1 (aws ec2 describe-availability-zones)"
}

ALL_REGIONS="us-east-1|N. Virginia
us-east-2|Ohio
us-west-1|N. California
us-west-2|Oregon
ca-central-1|Canada
ca-west-1|Calgary
sa-east-1|Sao Paulo
mx-central-1|Mexico
eu-west-1|Ireland
eu-west-2|London
eu-west-3|Paris
eu-central-1|Frankfurt
eu-central-2|Zurich
eu-north-1|Stockholm
eu-south-1|Milan
eu-south-2|Spain
ap-south-1|Mumbai
ap-south-2|Hyderabad
ap-southeast-1|Singapore
ap-southeast-2|Sydney
ap-southeast-3|Jakarta
ap-southeast-4|Melbourne
ap-southeast-5|Malaysia
ap-southeast-7|Thailand
ap-northeast-1|Tokyo
ap-northeast-2|Seoul
ap-northeast-3|Osaka
ap-east-1|Hong Kong
me-south-1|Bahrain
me-central-1|UAE
il-central-1|Tel Aviv
af-south-1|Cape Town"
region_list() { cut -d'|' -f1 <<<"${ALL_REGIONS}"; }
region_name() { awk -F'|' -v r="$1" '$1 == r {print $2; exit}' <<<"${ALL_REGIONS}"; }

pick() {
    local list w out=""
    read -r -a list <<<"$1"
    for w in $(tr ',' ' ' <<<"$2"); do
        if [[ "${w}" =~ ^[0-9]+$ && "${w}" -ge 1 && "${w}" -le "${#list[@]}" ]]; then out+="${list[$((w - 1))]} "; else out+="${w} "; fi
    done
    echo "${out% }"
}

head1 "1. AWS accounts on this machine"
PROFILE_ACCOUNTS="${PROFILE_ACCOUNTS:-}"   # "<profile> <account>" for profiles that are logged in
profile_rows=""
for p in $(aws configure list-profiles 2>/dev/null); do
    a="$(caller_account "${p}")"
    if [[ -n "${a}" ]]; then
        [[ "${PROFILE_ACCOUNTS}" == *"${p} ${a}"* ]] || PROFILE_ACCOUNTS+="${p} ${a}"$'\n'
        profile_rows+="${p}|${a}|logged in"$'\n'
    else
        a="$(aws configure get sso_account_id --profile "${p}" 2>/dev/null || true)"
        profile_rows+="${p}|${a:-?}|not logged in (aws sso login --profile ${p})"$'\n'
    fi
done
if [[ -n "${profile_rows}" ]]; then
    printf '  %-16s %-14s %s\n' "PROFILE" "ACCOUNT" "STATUS"
    while IFS='|' read -r p a st; do [[ -n "${p}" ]] && printf '  %-16s %-14s %s\n' "${p}" "${a}" "${st}"; done <<<"${profile_rows}"
else
    warn "no AWS profiles on this machine (aws configure sso adds one); you can still answer with account IDs"
fi
first_profile="$(awk 'NF {print $1; exit}' <<<"${PROFILE_ACCOUNTS}")"
ORG_ACCOUNTS=""
for p in $(awk 'NF {print $1}' <<<"${PROFILE_ACCOUNTS}"); do
    ORG_ACCOUNTS="$(aws organizations list-accounts --profile "${p}" --query 'Accounts[?Status==`ACTIVE`].[Id,Name]' --output text 2>/dev/null || true)"
    [[ -n "${ORG_ACCOUNTS}" ]] && break
done

known_accounts="$( { awk 'NF {print $1}' <<<"${ORG_ACCOUNTS}"; awk -F'|' 'NF && $2 ~ /^[0-9]{12}$/ {print $2}' <<<"${profile_rows}"; for r in $(region_files); do yq -r '[.hub.account_id] + [.vpcs // {} | .[] | .account_id] | .[] | select(. != "" and . != null)' "${CONFIG_DIR}/${r}.yml"; done; global_account; } | { grep -E '^[0-9]{12}$' || true; } | awk '!seen[$0]++' | xargs)"
account_label() {
    local n; n="$(awk -v a="$1" '$1 == a { $1 = ""; sub(/^ /, ""); print; exit }' <<<"${ORG_ACCOUNTS}")"
    [[ -z "${n}" ]] && n="$(awk -F'|' -v a="$1" '$2 == a {printf "%s%s", sep, $1; sep = ", "}' <<<"${profile_rows}")"
    echo "${n}"
}
echo
if [[ -n "${known_accounts}" ]]; then
    say "Accounts found:"
    i=1; for a in ${known_accounts}; do say "  ${i}) ${a}  $(account_label "${a}")"; i=$((i + 1)); done
fi

head1 "2. Accounts this repository uses"
say "One account: everything, hubs and every environment, lives in it. Several: the hubs in a shared account, environments in"
say "their own (each environment's account is chosen at step 5). Numbers from the list, or 12-digit IDs; blank if none exist yet."
default_accounts=""; for a in ${known_accounts}; do [[ " $(for r in $(region_files); do yq -r '[.hub.account_id] + [.vpcs // {} | .[] | .account_id] | .[]' "${CONFIG_DIR}/${r}.yml"; done; global_account) " == *"${a}"* ]] && default_accounts+="${a} "; done
while true; do
    chosen="$(pick "${known_accounts}" "$(ask "Accounts" "${default_accounts% }")")"
    bad=""; for a in ${chosen}; do [[ "${a}" =~ ^[0-9]{12}$ ]] || bad+="${a} "; done
    [[ -z "${bad}" ]] && break
    warn "not an account: ${bad}(a number from the list, or a 12-digit ID)"
done
n_accounts="$(wc -w <<<"${chosen}" | tr -d ' ')"
global_acct=""; hub_account=""; org_sharing="false"
if [[ "${n_accounts}" -le 1 ]]; then
    mode=one; global_acct="${chosen}"
    ok "one account$( [[ -n "${chosen}" ]] && echo ": ${chosen}" || echo ", to be filled in once it exists")"
else
    mode=each
    say "Which is the shared account, for the hubs and everything every environment uses?"
    i=1; for a in ${chosen}; do say "  ${i}) ${a}  $(account_label "${a}")"; i=$((i + 1)); done
    d="$(cur "$(primary_region)" .hub.account_id)"; [[ -z "${d}" ]] && d="1"
    hub_account="$(pick "${chosen}" "$(ask_valid "Shared account" "${d}" '^[0-9]+$' "a number from the list, or a 12-digit ID")")"
    if ask_yes "Are they in one AWS Organization with RAM sharing turned on (shares then need no accepting)?" "$([[ -n "${ORG_ACCOUNTS}" ]] && echo y || echo n)"; then org_sharing="true"; fi
fi

head1 "3. Regions"
enabled=""
[[ -n "${first_profile}" ]] && enabled="$(aws ec2 describe-regions --all-regions --profile "${first_profile}" --query 'Regions[?OptInStatus!=`not-opted-in`].RegionName' --output text 2>/dev/null | tr '\t' ' ' || true)"
all="$(region_list | xargs)"
i=1; line=""
for r in ${all}; do
    mark=""; [[ -n "${enabled}" && " ${enabled} " != *" ${r} "* ]] && mark=" (not enabled)"
    cell="$(printf '%2d) %-15s %s%s' "${i}" "${r}" "$(region_name "${r}")" "${mark}")"
    if [[ -z "${line}" ]]; then line="$(printf '%-48s' "${cell}")"; else say "${line}${cell}"; line=""; fi
    i=$((i + 1))
done
[[ -n "${line}" ]] && say "${line}"
old_primary="$(primary_region)"
default_regions="${old_primary}"; for r in $(region_files); do [[ "${r}" != "${old_primary}" ]] && default_regions+=" ${r}"; done
while true; do
    regions="$(pick "${all}" "$(ask "Regions, the primary first (numbers or names)" "${default_regions:-us-east-1}")")"
    bad=""; for r in ${regions}; do [[ " ${all} " == *" ${r} "* ]] || bad+="${r} "; done
    [[ -n "${regions}" && -z "${bad}" ]] && break
    warn "not a region: ${bad:-none given}"
done
primary="$(awk '{print $1}' <<<"${regions}")"
[[ -n "${enabled}" ]] && for r in ${regions}; do [[ " ${enabled} " == *" ${r} "* ]] || warn "${r} is not enabled for ${first_profile}'s account: enable it in the account first"; done
ok "primary ${primary} ($(region_name "${primary}"))$( [[ "$(wc -w <<<"${regions}")" -gt 1 ]] && echo "; also ${regions#"${primary}" }")"

head1 "4. Environments"
old_envs="$(for r in $(region_files); do yq -r '.vpcs // {} | keys | .[]' "${CONFIG_DIR}/${r}.yml"; done | awk '!seen[$0]++' | xargs || true)"
while true; do
    envs="$(ask "Environment names, space-separated" "${old_envs:-development staging production}")"
    bad=""; for e in ${envs}; do [[ "${e}" =~ ${RE_ENV} && "${RESERVED_ENVS}" != *" ${e} "* ]] || bad+="${e} "; done
    [[ -n "${envs}" && -z "${bad}" ]] && break
    warn "not allowed: ${bad}(lowercase, start with a letter, not shared, global or common)"
done

head1 "5. Where each environment runs"
say "Regions: $(i=1; for r in ${regions}; do printf '%d) %s  ' "${i}" "${r}"; i=$((i + 1)); done)"
[[ "${mode}" == each ]] && say "Accounts: $(i=1; for a in ${chosen}; do printf '%d) %s %s  ' "${i}" "${a}" "$(account_label "${a}")"; i=$((i + 1)); done)"
for e in ${envs}; do
    d=""; for r in ${regions}; do [[ -n "$(cur "${r}" ".vpcs.\"${e}\".cidr")" ]] && d+="${r} "; done; [[ -n "${d}" ]] || d="${primary}"
    while true; do
        er="$(pick "${regions}" "$(ask "${e}: regions" "${d% }")")"
        bad=""; for r in ${er}; do [[ " ${regions} " == *" ${r} "* ]] || bad+="${r} "; done
        [[ -n "${er}" && -z "${bad}" ]] && break
        warn "not one of the regions chosen at step 3: ${bad:-none given}"
    done
    put "${e}_regions" "${er}"
    if [[ "${mode}" == each ]]; then
        d="$(account_for "${e}")"; [[ -n "${d}" && " ${chosen} " == *" ${d} "* ]] || d="$(awk -v n="${e}" 'tolower($0) ~ tolower(n) {print $1; exit}' <<<"${ORG_ACCOUNTS}")"
        put "${e}_account" "$(pick "${chosen}" "$(ask_valid "${e}: account" "${d:-${hub_account}}" '^[0-9]+$' "a number from the list, or a 12-digit ID")")"
    fi
done
echo
say "Pairing:"
for r in ${regions}; do
    on=""; for e in ${envs}; do [[ " $(get "${e}_regions") " == *" ${r} "* ]] && on+="${e} "; done
    put "${r}_envs" "${on% }"
    say "  ${r} ($(region_name "${r}")): ${on:-no environments, the hub only}"
done

TODO_TEAM="TODO(you): the team that owns it, for the Team tag"
for r in ${regions}; do
    d=""; [[ -f "${CONFIG_DIR}/${r}.yml" ]] && d="$(cur "${r}" '.zones | join(",")')"
    if [[ -n "${d}" ]] && grep -qE '^zones:.*TODO\(you\):' "${CONFIG_DIR}/${r}.yml"; then
        d=""
    fi
    if [[ -z "${d}" && -n "${first_profile}" ]]; then
        d="$(aws ec2 describe-availability-zones --region "${r}" --profile "${first_profile}" --filters Name=zone-type,Values=availability-zone \
            --query 'AvailabilityZones[].ZoneId' --output text 2>/dev/null | tr '\t' '\n' | sort | head -n 3 | paste -sd, - || true)"
    fi
    if [[ -n "${d}" ]]; then put "${r}_zones" "${d}"; put "${r}_zones_guessed" ""
    else zp="$(zone_prefix "${r}")"; put "${r}_zones" "${zp}-az1,${zp}-az2,${zp}-az3"; put "${r}_zones_guessed" yes; fi
    d="$(cur "${r}" .hub.amazon_side_asn)"; put "${r}_asn" "${d}"
done
i=0; for r in ${regions}; do [[ -n "$(get "${r}_asn")" ]] || put "${r}_asn" "$((64512 + i))"; i=$((i + 1)); done
hub_team="$(cur "${old_primary}" .hub.team)"
for e in ${envs}; do
    first_r="$(awk '{print $1}' <<<"$(get "${e}_regions")")"
    put "${e}_team" "$(cur "${first_r}" ".vpcs.\"${e}\".team")"
    d="$(cur "${first_r}" ".vpcs.\"${e}\".segment")"; [[ -n "${d}" ]] || { [[ "${e}" == prod* ]] && d=restricted || d=standard; }
    put "${e}_segment" "${d}"
    d="$(cur "${first_r}" ".vpcs.\"${e}\".public")"; put "${e}_public" "${d:-false}"
done
state_bucket="$(yq -r '.state.bucket // ""' "${CONFIG_DIR}/global.yml")"
d="$(yq -r '.state.region // ""' "${CONFIG_DIR}/global.yml")"; state_region="${d:-${primary}}"
d="$(yq -r '.state.replica_region // ""' "${CONFIG_DIR}/global.yml")"; replica_region="${d:-$(awk '{print $2}' <<<"${regions}")}"

head1 "6. IP scope"
say "Every network is planned inside one range, so none overlaps another or anything you will connect to. Hubs get a /20"
say "each, from the first free /16; every environment gets a /16 in every region it runs in. Ranges already in config/ are kept."
for r in $(region_files); do for c in $(yq -r '[.hub.cidr] + [.vpcs // {} | .[] | .cidr] | .[]' "${CONFIG_DIR}/${r}.yml" 2>/dev/null); do take_cidr "${c}"; done; done
for r in ${regions}; do
    for p in $(awk 'NF {print $1}' <<<"${PROFILE_ACCOUNTS}"); do
        for c in $(aws ec2 describe-vpcs --region "${r}" --profile "${p}" --query 'Vpcs[].CidrBlock' --output text 2>/dev/null || true); do [[ "${c}" == 10.* ]] && take_cidr "${c}"; done
    done
done
needed=1; for r in ${regions}; do for e in $(get "${r}_envs"); do [[ -n "$(cur "${r}" ".vpcs.\"${e}\".cidr")" ]] || needed=$((needed + 1)); done; done
d="10.40.0.0/13"; [[ "${needed}" -gt 6 ]] && d="10.32.0.0/12"; [[ "${needed}" -gt 14 ]] && d="10.32.0.0/11"
while true; do
    scope="$(ask_valid "IP scope, inside 10.0.0.0/8 (/8 to /16)" "${d}" '^10\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}/([89]|1[0-6])$' "a range such as 10.40.0.0/13")"
    aligned="$(int_to_ip $(( $(ip_to_int "${scope%/*}") & ~((1 << (32 - ${scope#*/})) - 1) )))/${scope#*/}"
    if [[ "${aligned}" != "${scope}" ]]; then warn "${scope} is not where that range starts; it would be ${aligned}. Give ${aligned}, or a smaller range."; continue; fi
    free=""; for c in $(slash16s "${scope}"); do [[ "${used_octets}" == *" $(cut -d. -f2 <<<"${c}") "* ]] || free+="${c} "; done
    [[ "$(wc -w <<<"${free}" | tr -d ' ')" -ge "${needed}" ]] && break
    warn "${scope} has $(wc -w <<<"${free}" | tr -d ' ') free /16s; this plan needs ${needed}. Choose a wider scope."
done
take() { TAKEN="${free%% *}"; free="${free#"${TAKEN}"}"; free="${free# }"; take_cidr "${TAKEN}"; }
hub_block=""
i=0
for r in ${regions}; do
    d="$(cur "${r}" .hub.cidr)"
    if [[ -z "${d}" ]]; then
        [[ -n "${hub_block}" ]] || { take; hub_block="${TAKEN}"; }
        d="$(int_to_ip $(( $(ip_to_int "${hub_block%/*}") + (i << 12) )))/20"
    fi
    put "${r}_hub_cidr" "${d}"; i=$((i + 1))
    for e in $(get "${r}_envs"); do
        d="$(cur "${r}" ".vpcs.\"${e}\".cidr")"; [[ -n "${d}" ]] || { take; d="${TAKEN}"; }
        put "${e}_${r}_cidr" "${d}"
    done
done
show_plan() {
    printf '  %-12s %-14s %s\n' "REGION" "NETWORK" "CIDR"
    for r in ${regions}; do
        printf '  %-12s %-14s %s\n' "${r}" "hub" "$(get "${r}_hub_cidr")"
        for e in $(get "${r}_envs"); do printf '  %-12s %-14s %s\n' "" "${e}" "$(get "${e}_${r}_cidr")"; done
    done
}
echo; show_plan; echo
if ! ask_yes "Use this plan?" y; then
    for r in ${regions}; do
        put "${r}_hub_cidr" "$(ask_valid "${r} hub (a /20)" "$(get "${r}_hub_cidr")" "${RE_CIDR20}" "a /20 inside 10.0.0.0/8")"
        for e in $(get "${r}_envs"); do put "${e}_${r}_cidr" "$(ask_valid "${r} ${e} (a /16)" "$(get "${e}_${r}_cidr")" "${RE_CIDR16}" "a /16 inside 10.0.0.0/8")"; done
    done
fi

WORK="$(mktemp -d)"; trap 'rm -rf "${WORK:?}"' EXIT
mkdir -p "${WORK}/config"; cp "${CONFIG_DIR}/global.yml" "${WORK}/config/global.yml"; G="${WORK}/config/global.yml"
GA="${global_acct}" OS="${org_sharing}" SB="${state_bucket}" SR="${state_region}" yq -i '.account_id = strenv(GA) | .organization_sharing = (strenv(OS) == "true") | .state.bucket = strenv(SB) | .state.region = strenv(SR)' "${G}"
if [[ -n "${replica_region}" ]]; then RR="${replica_region}" yq -i '.state.replica_region = strenv(RR)' "${G}"; else yq -i 'del(.state.replica_region)' "${G}"; fi
yq -i '.sites = (.sites // {})' "${G}"
[[ "${mode}" == one && -z "${global_acct}" ]] && yq -i '.account_id line_comment="TODO(you): the account ID, once the account exists"' "${G}"
[[ -z "${state_bucket}" ]] && yq -i '.state.bucket line_comment="blank: make bootstrap creates terraform-state-<account>-<region>, or set an existing bucket"' "${G}"

todo_if_blank() { [[ -n "$1" ]] && echo "$1" || echo "  # $2"; }
for r in ${regions}; do
    {
        echo "zones:$( [[ -n "$(get "${r}_zones_guessed")" ]] && echo "  # TODO(you): standard zone IDs, not looked up; check them with aws ec2 describe-availability-zones --region ${r}")"
        tr ',' '\n' <<<"$(get "${r}_zones")" | sed 's/^/  - /'
        echo "hub:"
        echo "  account_id: \"${hub_account}\"$( [[ "${mode}" == each && -z "${hub_account}" ]] && echo "  # TODO(you): the shared account's ID, once it exists")"
        echo "  team: ${hub_team}$( [[ -z "${hub_team}" ]] && echo "  # ${TODO_TEAM}")"
        echo "  cidr: $(get "${r}_hub_cidr")"
        echo "  amazon_side_asn: $(get "${r}_asn")"
        [[ "${r}" == "${primary}" ]] && echo "  primary: true"
        echo "  security_group_referencing: $(cur "${r}" .hub.security_group_referencing | grep . || echo false)"
        if [[ -n "$(get "${r}_envs")" ]]; then
            echo "vpcs:"
            for e in $(get "${r}_envs"); do
                echo "  ${e}:"
                echo "    account_id: \"$(get "${e}_account")\"$( [[ "${mode}" == each && -z "$(get "${e}_account")" ]] && echo "  # TODO(you): ${e}'s account ID, once it exists")"
                echo "    team: $(get "${e}_team")$( [[ -z "$(get "${e}_team")" ]] && echo "  # ${TODO_TEAM}")"
                echo "    cidr: $(get "${e}_${r}_cidr")"
                echo "    segment: $(get "${e}_segment")"
                echo "    public: $(get "${e}_public")"
            done
        fi
    } > "${WORK}/config/${r}.yml"
done

head1 "Checking the answers"
problems="$(ip_plan_problems "${WORK}/config")"
if [[ -n "${problems}" ]]; then
    bad "the IP plan refuses these answers; nothing was written:"
    sed 's/^/      /' <<<"${problems}"
    exit 1
fi
ok "the IP plan accepts them: ranges, segments, ASNs and accounts are consistent"

creates=""; removals=""
asked_examples=" "
plan_env() { # plan_env <region> <env>
    local from="" c
    ls "live/$1/$2"/*/main.tf >/dev/null 2>&1 && return 0
    if [[ -d "${EXAMPLES}" ]]; then
        if [[ "${asked_examples}" == *" $2=yes "* ]]; then from="${EXAMPLES}"
        elif [[ "${asked_examples}" != *" $2=no "* ]]; then
            if ask_yes "New environment $2: start from the example files in ${EXAMPLES} (no: empty stacks)?" n; then from="${EXAMPLES}"; asked_examples+="$2=yes "; else asked_examples+="$2=no "; fi
        fi
    fi
    for c in ${ENV_COMPONENTS}; do creates+="$1/$2/${c} ${from:+${from}/${c}}"$'\n'; done
}
for r in ${regions}; do
    for c in ${SHARED_COMPONENTS}; do [[ -f "live/${r}/shared/${c}/main.tf" ]] || creates+="${r}/shared/${c}"$'\n'; done
    for e in $(get "${r}_envs"); do plan_env "${r}" "${e}"; done
done
CONFIG_DIR_SAVED="${CONFIG_DIR}"; CONFIG_DIR="${WORK}/config"
while read -r s; do [[ -n "${s}" ]] && creates+="${s}"$'\n'; done <<<"$(missing_account_stacks)"
CONFIG_DIR="${CONFIG_DIR_SAVED}"
for d in live/*/; do
    r="$(basename "${d}")"
    [[ "${r}" == common || "${r}" == global || " ${regions} " == *" ${r} "* ]] && continue
    ls "live/${r}"/*/*/main.tf >/dev/null 2>&1 || continue
    ask_yes "${r} is no longer one of the regions. Delete all of its stacks, live/${r}?" n && removals+="live/${r}"$'\n'
done
for r in $(region_files); do
    [[ " ${regions} " == *" ${r} "* ]] || continue
    for e in $(yq -r '.vpcs // {} | keys | .[]' "${CONFIG_DIR}/${r}.yml"); do
        [[ " $(get "${r}_envs") " == *" ${e} "* ]] && continue
        ls "live/${r}/${e}"/*/main.tf >/dev/null 2>&1 || continue
        ask_yes "${e} no longer runs in ${r}. Delete its stacks, live/${r}/${e}?" n && removals+="live/${r}/${e}"$'\n'
    done
done

head1 "What will change"
if diff -ruN "${CONFIG_DIR}" "${WORK}/config" >/dev/null; then say "config/: no changes"; else diff -ruN "${CONFIG_DIR}" "${WORK}/config" | sed 's/^/  /' || true; fi
[[ -n "${removals}" ]] && while read -r d; do [[ -n "${d}" ]] && say "delete  ${d}"; done <<<"${removals}"
[[ -n "${creates}" ]] && while read -r s from; do [[ -n "${s}" ]] && say "create  live/${s}${from:+ (files from ${from})}"; done <<<"${creates}"
echo
ask_yes "Make these changes?" y || { say "Nothing changed."; exit 0; }

for f in "${CONFIG_DIR}"/*-*-[0-9].yml; do [[ -f "${WORK}/config/$(basename "${f}")" ]] || rm -f "${f}"; done
cp "${WORK}"/config/*.yml "${CONFIG_DIR}/"
[[ -n "${removals}" ]] && while read -r d; do [[ -n "${d}" && "${d}" == live/* ]] && rm -rf "${d:?}" && ok "deleted ${d}"; done <<<"${removals}"
created=""
if [[ -n "${creates}" ]]; then
    while read -r s from; do
        [[ -n "${s}" && ! -e "live/${s}/main.tf" ]] || continue
        bin/stack "${s}" >/dev/null
        if [[ -n "${from}" && -d "${from}" ]]; then
            find "${from}" -maxdepth 1 -name '*.yml' -exec cp {} "live/${s}/" \;
            for extra in src policies; do [[ -d "${from}/${extra}" ]] && cp -R "${from}/${extra}" "live/${s}/"; done
        fi
        created+="${s} "
    done <<<"${creates}"
    ok "created $(wc -w <<<"${created}" | tr -d ' ') stack(s)"
fi
bin/backends >/dev/null && ok "every stack's backend.tf written"
bin/diagram >/dev/null 2>&1 && ok "docs/diagram.md regenerated" || warn "docs/diagram.md not regenerated: run make diagram"
if [[ -n "${created}" ]] && ask_yes "Check the new stacks' files against a mocked AWS now?" y; then
    bin/check-files ${created} || warn "fix what is listed above, then make check-files"
fi

todos="$(grep -h "TODO(you):" "${CONFIG_DIR}"/*.yml 2>/dev/null | wc -l | tr -d ' ')"
head1 "Your turn"
if [[ "${todos}" -gt 0 ]]; then
    say "${todos} thing(s) in config/ need a person before the first plan, each marked TODO(you). make config shows them all."
fi
say "The new stacks are scaffolding: they build nothing until you add files beside them (examples/ has one for every stack)."
say "Next: make config, edit config/*.yml where it says TODO(you), then make status."
