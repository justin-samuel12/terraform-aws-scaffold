# Terraform working files and state
.terraform/
.terraform.d/
# Modules don't pin providers; only stacks commit a lock file.
modules/**/.terraform.lock.hcl
templates/**/.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
crash.*.log
.terraform.tfstate.lock.info

# Local settings and secrets
*.tfvars
*.tfvars.json
.env
*.env
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Editors and OS
.DS_Store
.idea/
.vscode/

# Python bytecode (Lambda sources)
__pycache__/
*.pyc

.claude/
.check-files/
